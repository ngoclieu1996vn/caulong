rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 60
        && name.matches("[\\p{L}\\p{M}.'-][\\p{L}\\p{M} .'-]*[\\p{L}\\p{M}.'-]")
        && name.matches('.*\\p{L}.*')
        && !name.matches('.*  .*');
    }
    function validPayload(data) {
      return data.keys().hasAll(['date', 'memberId', 'name', 'type', 'checkedInAt'])
        && data.keys().hasOnly(['date', 'memberId', 'name', 'type', 'checkedInAt'])
        && data.date is string
        && data.date.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && !data.date.matches('0000-.*')
        && validName(data.name)
        && data.checkedInAt is timestamp && data.checkedInAt == request.time;
    }
    function validMember(data, id) {
      let names = {
        'member_01': 'Bảo Long', 'member_02': 'Anh Nam', 'member_03': 'Lan Anh',
        'member_04': 'Minh Đức', 'member_05': 'Hoàng'
      };
      return data.type == 'member' && data.memberId is string
        && data.memberId in names
        && data.name == names[data.memberId]
        && id == data.date + '_' + data.memberId;
    }
    function validGuest(data, id) {
      return data.type == 'guest' && data.memberId == null
        && !id.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_member_.*');
    }
    match /checkins/{id} {
      allow read: if true;
      allow create: if validPayload(request.resource.data)
        && (validMember(request.resource.data, id) || validGuest(request.resource.data, id));
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
