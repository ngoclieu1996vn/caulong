{
  "name": "caulong-calendar-checkin",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/utils.test.mjs tests/participants.test.mjs tests/billing.test.mjs tests/team-games.test.mjs tests/money-input.test.mjs tests/password-hash.test.mjs",
    "test:avatars": "node --test tests/avatar-preview.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-calendar-checkin \"node --test tests/firestore.rules.test.mjs\"",
    "test:browser": "firebase emulators:exec --only firestore --project demo-calendar-checkin \"playwright test\"",
    "preview": "node tests/serve.mjs",
    "test:all": "firebase emulators:exec --only firestore --project demo-calendar-checkin \"node tests/verify.mjs\""
  },
  "engines": { "node": ">=24.12.0" },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.33.0"
  }
}
